# Defaults for app-k3s-server. Override any of these in the server's .env
#
# Available versions and hashes:
#   https://extensions.flatcar.org/extensions/k3s/SHA256SUMS
# Stay within a minor release unless you mean to upgrade Kubernetes.
# Change the pin here and commit it before running k3s-swap on the box, so a
# reprovision lands on the version the box runs.

K3S_VERSION=v1.36.5+k3s1
K3S_SHA256=e126e3df8469d59a84b6add3874c72d8c0a286a349749e18e49ff939a02b16e9
