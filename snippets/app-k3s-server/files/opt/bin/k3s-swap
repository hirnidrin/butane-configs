#!/bin/bash
#
# k3s-swap - update the k3s sysext in place, keeping what a rollback needs
#
#   k3s-swap status
#   k3s-swap to <version> <sha256>    e.g. to v1.37.1+k3s1 <64 hex>
#
# The k3s sysext is /opt/extensions/k3s/k3s-<version>-x86-64.raw, merged
# through the symlink /etc/extensions/k3s.raw. `to` downloads the new file
# from extensions.flatcar.org, verifies its hash, stops k3s, copies
# /var/lib/rancher/k3s/server/ (datastore and encryption config) aside,
# snapshots the containerd dataset, repoints the symlink, refreshes the
# sysexts and starts k3s again. The target must be newer and at most one
# Kubernetes minor ahead. The old file, the copy and the snapshot stay until
# `clean`; only one swap is kept at a time.
#
# Swap state: /var/lib/rancher/k3s-swap/ (from, to, server/).
# Change the k3s pin in the Butane config first, so a reprovision lands on
# the same version. This script never touches the config.
#
# Exit 2: refused before anything changed. Exit 1: failed while acting.
# K3S_SWAP_ROOT prefixes every path (tests only); K3S_SWAP_TIMEOUT is how
# long to wait for the node, in seconds (default 300).
#
set -euo pipefail

R="${K3S_SWAP_ROOT:-}"
EXT_DIR=/opt/extensions/k3s
LINK="$R/etc/extensions/k3s.raw"
SERVER="$R/var/lib/rancher/k3s/server"
CONTAINERD="$R/var/lib/rancher/k3s/agent/containerd"
STATE="$R/var/lib/rancher/k3s-swap"
SNAP_NAME=k3s-swap-pre
URL_BASE=https://extensions.flatcar.org/extensions
TIMEOUT="${K3S_SWAP_TIMEOUT:-300}"
VERSION_RE='^v1\.([0-9]+)\.([0-9]+)\+k3s([0-9]+)$'

die() {
	echo "k3s-swap: $*" >&2
	exit 2
}

fail() {
	echo "k3s-swap: $*" >&2
	exit 1
}

raw_path() { echo "$EXT_DIR/k3s-$1-x86-64.raw"; }

current_version() {
	local target name
	target="$(readlink "$LINK")" || die "$LINK is not a symlink"
	name="$(basename "$target")"
	name="${name#k3s-}"
	name="${name%-x86-64.raw}"
	[[ "$name" =~ $VERSION_RE ]] || die "can't read the k3s version from $target"
	echo "$name"
}

# newer_by_at_most_one_minor <current> <target>
newer_by_at_most_one_minor() {
	local cm cp cr
	[[ "$1" =~ $VERSION_RE ]]
	cm="${BASH_REMATCH[1]}" cp="${BASH_REMATCH[2]}" cr="${BASH_REMATCH[3]}"
	[[ "$2" =~ $VERSION_RE ]]
	local tm="${BASH_REMATCH[1]}" tp="${BASH_REMATCH[2]}" tr="${BASH_REMATCH[3]}"
	[ "$tm" -eq $((cm + 1)) ] && return 0
	[ "$tm" -eq "$cm" ] || return 1
	[ "$tp" -gt "$cp" ] || { [ "$tp" -eq "$cp" ] && [ "$tr" -gt "$cr" ]; }
}

containerd_dataset() {
	mountpoint -q "$CONTAINERD" || die "$CONTAINERD is not mounted (pool not imported?)"
	findmnt -n -o SOURCE "$CONTAINERD"
}

# wait_for <version> - until the node is Ready and reports <version>
wait_for() {
	local deadline=$((SECONDS + TIMEOUT))
	while :; do
		if [ "$(k3s kubectl get nodes -o jsonpath='{.items[*].status.nodeInfo.kubeletVersion}' 2>/dev/null)" = "$1" ] &&
			k3s kubectl wait --for=condition=Ready node --all --timeout=10s >/dev/null 2>&1; then
			return 0
		fi
		[ "$SECONDS" -lt "$deadline" ] || return 1
		sleep 1
	done
}

cmd_status() {
	echo "current: $(current_version)"
	if [ ! -e "$STATE" ]; then
		echo "swap: none"
	elif [ -e "$STATE/to" ]; then
		echo "swap: $(cat "$STATE/from") -> $(cat "$STATE/to") (undo: k3s-swap rollback; done: k3s-swap clean)"
	else
		echo "swap: incomplete, from $(cat "$STATE/from" 2>/dev/null || echo unknown) (undo: k3s-swap rollback)"
	fi
}

cmd_to() {
	[ $# -eq 2 ] || die "usage: k3s-swap to <version> <sha256>"
	local version="$1" sha="$2" current dataset file
	[[ "$version" =~ $VERSION_RE ]] || die "bad version '$version' (want e.g. v1.37.1+k3s1)"
	[[ "$sha" =~ ^[0-9a-f]{64}$ ]] || die "bad sha256 '$sha'"
	[ ! -e "$STATE" ] || die "an earlier swap is still kept in $STATE: k3s-swap clean (keep it) or k3s-swap rollback (undo it) first"
	current="$(current_version)"
	newer_by_at_most_one_minor "$current" "$version" ||
		die "$current -> $version: the target must be newer and at most one minor ahead"
	dataset="$(containerd_dataset)"

	file="$R$(raw_path "$version")"
	rm -f "$file.partial"
	curl -fsSL --retry 3 -o "$file.partial" "$URL_BASE/k3s-$version-x86-64.raw" ||
		{ rm -f "$file.partial"; fail "download failed"; }
	if ! echo "$sha  $file.partial" | sha256sum -c --status; then
		rm -f "$file.partial"
		fail "hash mismatch for $version: nothing changed"
	fi
	mv "$file.partial" "$file"

	trap 'echo "k3s-swap: failed after stopping k3s; undo with: k3s-swap rollback" >&2' ERR
	systemctl stop k3s
	mkdir -p "$STATE"
	echo "$current" >"$STATE/from"
	cp -a "$SERVER" "$STATE/server"
	zfs snapshot "$dataset@$SNAP_NAME"
	ln -sfn "$(raw_path "$version")" "$LINK"
	systemd-sysext refresh
	systemctl start k3s
	wait_for "$version" || fail "node not Ready on $version after $TIMEOUT seconds; undo with: k3s-swap rollback"
	trap - ERR
	echo "$version" >"$STATE/to"
	echo "k3s: $current -> $version"
}

[ $# -ge 1 ] || die "usage: k3s-swap status | to <version> <sha256>"
sub="$1"
shift
case "$sub" in
status) cmd_status ;;
to) cmd_to "$@" ;;
*) die "unknown subcommand '$sub'" ;;
esac
