# Defaults for app-wg-easy. Override any of these in the server's .env

WG_EASY_IMAGE=ghcr.io/wg-easy/wg-easy:15

# UDP port for incoming road warrior connections - forward this from the WAN
WG_PORT=51820

# Host-localhost port the webadmin is published on. Not reachable from the
# network; app-caddy-tls-proxy proxies to it.
WG_EASY_UI_LOCAL_PORT=51822
