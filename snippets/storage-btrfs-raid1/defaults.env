# Defaults for storage-btrfs-raid1. Override any of these in the server's .env

# The two devices to mirror. Verify against `lsblk` on the target machine.
RAID_DEVICE_A=/dev/nvme0n1
RAID_DEVICE_B=/dev/nvme1n1

RAID_LABEL=K3S_DATA
RAID_MOUNT_PATH=/var/lib/rancher/k3s

# true wipes partition tables and filesystems on BOTH devices. Needed when the
# disks carry old signatures; leave false to refuse rather than destroy.
RAID_WIPE=false
