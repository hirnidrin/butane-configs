# Defaults for app-caddy-tls-proxy. Override any of these in the server's .env

CADDY_IMAGE=docker.io/library/caddy:2-alpine

# TLS port caddy listens on, for LAN clients
CADDY_TLS_PORT=8443

# What caddy proxies to - a port published to the host's loopback only
CADDY_UPSTREAM=127.0.0.1:51822

# Plain-HTTP port that gets redirected to CADDY_TLS_PORT (wg-easy's own
# webadmin port, kept as a convenience redirect for old bookmarks)
CADDY_REDIRECT_PORT=51821
