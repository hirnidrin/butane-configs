#!/bin/bash
#
# zfs-autosnap - take one recursive snapshot of each dataset tree and prune old ones
#
#   zfs-autosnap hourly|daily|weekly
#
# Config, sourced from ZFS_AUTOSNAP_CONF (default /etc/zfs-autosnap.conf):
#   AUTOSNAP_DATASETS      roots of the trees, space-separated, e.g. "tank/projects"
#   AUTOSNAP_KEEP_HOURLY   how many snapshots of each class to keep, >= 1
#   AUTOSNAP_KEEP_DAILY
#   AUTOSNAP_KEEP_WEEKLY
#
# Snapshots are named <dataset>@autosnap-<class>-<UTC timestamp>. Only those
# are pruned, oldest first, and each is destroyed with -r because it was taken
# with -r. Manual snapshots are never touched. Usage and config are validated
# before the first zfs call: a bad config takes no snapshot and deletes nothing.
# A tree that fails (say, it doesn't exist yet) is reported and skipped; the
# others still run, and the run exits 1.
#
set -euo pipefail

die() {
	echo "zfs-autosnap: $*" >&2
	exit 2
}

[ $# -eq 1 ] || die "usage: zfs-autosnap hourly|daily|weekly"
class="$1"
case "$class" in
hourly) keep_var=AUTOSNAP_KEEP_HOURLY ;;
daily) keep_var=AUTOSNAP_KEEP_DAILY ;;
weekly) keep_var=AUTOSNAP_KEEP_WEEKLY ;;
*) die "unknown class '$class'" ;;
esac

conf="${ZFS_AUTOSNAP_CONF:-/etc/zfs-autosnap.conf}"
[ -r "$conf" ] || die "cannot read $conf"
# shellcheck disable=SC1090
. "$conf"

# read -a splits on spaces without expanding globs.
read -ra datasets <<<"${AUTOSNAP_DATASETS:-}"
keep="${!keep_var:-}"
[ "${#datasets[@]}" -gt 0 ] || die "no AUTOSNAP_DATASETS"
for dataset in "${datasets[@]}"; do
	[[ "$dataset" =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$ ]] || die "bad dataset '$dataset' in AUTOSNAP_DATASETS"
done
[[ "$keep" =~ ^[1-9][0-9]*$ ]] || die "bad $keep_var '$keep'"

# snap_tree <dataset> - snapshot the tree, then prune its class. Called
# after ||, so set -e is off in here: every failure returns explicitly.
snap_tree() {
	local prefix="$1@autosnap-$class-"
	zfs snapshot -r "$prefix$(date -u +%Y%m%dT%H%MZ)" || return 1
	zfs list -H -t snapshot -o name -s creation -d 1 "$1" |
		{ grep -F "$prefix" || true; } |
		head -n "-$keep" |
		while read -r snap; do
			zfs destroy -r "$snap" || exit 1
		done
}

rc=0
for dataset in "${datasets[@]}"; do
	snap_tree "$dataset" || {
		echo "zfs-autosnap: $class snapshot of $dataset failed" >&2
		rc=1
	}
done
exit $rc
