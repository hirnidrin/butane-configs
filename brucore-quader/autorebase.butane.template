variant: fcos
version: 1.6.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ${SSH_PUBKEY}
      password_hash: ${PASSWORD_HASH}
storage:
  directories:
    - path: /etc/brucore-autorebase
      mode: 0755
    - path: /var/syncthing
      mode: 0755
      user:
        name: core
      group:
        name: core
    - path: /var/home/core/.config
      mode: 0755
      user:
        name: core
      group:
        name: core
    - path: /var/home/core/.config/containers
      mode: 0755
      user:
        name: core
      group:
        name: core
    - path: /var/home/core/.config/containers/systemd
      mode: 0755
      user:
        name: core
      group:
        name: core
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: ${HOSTNAME}
    - path: /etc/NetworkManager/system-connections/static-eno1.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=static-eno1
          type=ethernet
          interface-name=eno1

          [ipv4]
          method=manual
          address1=${IPV4_ADDRESS}
          gateway=${IPV4_GATEWAY}
          dns=${IPV4_DNS};

          [ipv6]
          method=disabled
    - path: /var/home/core/.config/containers/systemd/syncthing.container
      mode: 0644
      user:
        name: core
      group:
        name: core
      contents:
        inline: |
          [Unit]
          Description=Syncthing container
          Wants=network-online.target
          After=network-online.target
          ConditionPathExists=/etc/brucore-autorebase/signed

          [Container]
          Image=docker.io/syncthing/syncthing:latest
          Network=host
          Environment=PUID=0
          Environment=PGID=0
          Environment=STGUIADDRESS=${SYNCTHING_GUI_ADDRESS}
          Volume=/var/syncthing:/var/syncthing:Z
          AutoUpdate=registry

          [Service]
          Restart=always

          [Install]
          WantedBy=default.target
    - path: /var/lib/systemd/linger/core
      mode: 0644
    - path: /usr/local/bin/set-fanspeeds.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          # Set fan mode to full manual control, preventing BMC from overriding speed settings
          /usr/bin/ipmitool raw 0x30 0x45 0x01 0x01
          # Give BMC time to apply the mode change before setting target speeds
          /usr/bin/sleep 20
          # CPU fans: 40% duty cycle (~700rpm)
          /usr/bin/ipmitool raw 0x30 0x70 0x66 0x01 0x00 0x2A
          # Peripheral fans: 29% duty cycle (~500rpm)
          /usr/bin/ipmitool raw 0x30 0x70 0x66 0x01 0x01 0x1d
systemd:
  units:
    - name: brucore-unsigned-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=brucore autorebase to unsigned OCI and reboot
        ConditionPathExists=!/etc/brucore-autorebase/unverified
        ConditionPathExists=!/etc/brucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/hirnidrin/brucore:latest
        ExecStart=/usr/bin/touch /etc/brucore-autorebase/unverified
        ExecStart=/usr/bin/systemctl disable brucore-unsigned-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
    - name: brucore-signed-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=brucore autorebase to signed OCI and reboot
        ConditionPathExists=/etc/brucore-autorebase/unverified
        ConditionPathExists=!/etc/brucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-image-signed:docker://ghcr.io/hirnidrin/brucore:latest
        ExecStart=/usr/bin/touch /etc/brucore-autorebase/signed
        ExecStart=/usr/bin/systemctl disable brucore-signed-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
    - name: fanspeed.service
      enabled: true
      contents: |
        [Unit]
        Description=Set IPMI fan speeds
        ConditionPathExists=/etc/brucore-autorebase/signed
        After=multi-user.target
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        ExecStart=/usr/local/bin/set-fanspeeds.sh
        [Install]
        WantedBy=multi-user.target
    - name: syncthing-firewall-setup.service
      enabled: true
      contents: |
        [Unit]
        Description=Configure firewall for Syncthing
        ConditionPathExists=/etc/brucore-autorebase/signed
        ConditionPathExists=!/etc/brucore-autorebase/syncthing-firewall-configured
        After=firewalld.service
        Wants=firewalld.service
        Before=syncthing.service
        [Service]
        Type=oneshot
        ExecStart=/usr/bin/firewall-cmd --permanent --add-service=syncthing
        ExecStart=/usr/bin/firewall-cmd --permanent --add-service=syncthing-gui
        ExecStart=/usr/bin/firewall-cmd --reload
        ExecStart=/usr/bin/touch /etc/brucore-autorebase/syncthing-firewall-configured
        ExecStart=/usr/bin/systemctl disable syncthing-firewall-setup.service
        [Install]
        WantedBy=multi-user.target
