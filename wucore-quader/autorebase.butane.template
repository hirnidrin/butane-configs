variant: fcos
version: 1.6.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ${SSH_PUBKEY}
storage:
  directories:
    - path: /etc/ignition-task-tracking
      mode: 0755
      group:
        name: core
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: ${HOSTNAME}
    - path: /etc/NetworkManager/system-connections/static-eno1.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=static-eno1
          type=ethernet
          interface-name=eno1

          [ipv4]
          method=manual
          address1=${IPV4_ADDRESS}
          gateway=${IPV4_GATEWAY}
          dns=${IPV4_DNS};

          [ipv6]
          method=disabled
    - path: /var/lib/systemd/linger/core
      mode: 0644
    - path: /usr/local/bin/set-fanspeeds.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          # Set fan mode to full manual control, preventing BMC from overriding speed settings
          /usr/bin/ipmitool raw 0x30 0x45 0x01 0x01
          # Give BMC time to apply the mode change before setting target speeds
          /usr/bin/sleep 20
          # CPU fans: 40% duty cycle (~700rpm)
          /usr/bin/ipmitool raw 0x30 0x70 0x66 0x01 0x00 0x2A
          # Peripheral fans: 29% duty cycle (~500rpm)
          /usr/bin/ipmitool raw 0x30 0x70 0x66 0x01 0x01 0x1d
systemd:
  units:
    - name: rebase-to-unverified.service
      enabled: true
      contents: |
        [Unit]
        Description=Autorebase to unsigned OCI and reboot
        ConditionPathExists=!/etc/ignition-task-tracking/0-rebase-to-unverified
        ConditionPathExists=!/etc/ignition-task-tracking/1-rebase-to-signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/hirnidrin/wucore:latest
        ExecStart=/usr/bin/touch /etc/ignition-task-tracking/0-rebase-to-unverified
        ExecStart=/usr/bin/systemctl disable rebase-to-unverified.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
    - name: rebase-to-signed.service
      enabled: true
      contents: |
        [Unit]
        Description=Autorebase to signed OCI and reboot
        ConditionPathExists=/etc/ignition-task-tracking/0-rebase-to-unverified
        ConditionPathExists=!/etc/ignition-task-tracking/1-rebase-to-signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-image-signed:docker://ghcr.io/hirnidrin/wucore:latest
        ExecStart=/usr/bin/touch /etc/ignition-task-tracking/1-rebase-to-signed
        ExecStart=/usr/bin/systemctl disable rebase-to-signed.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
    - name: fanspeed.service
      enabled: true
      contents: |
        [Unit]
        Description=Set IPMI fan speeds after each boot
        ConditionPathExists=/etc/ignition-task-tracking/1-rebase-to-signed
        After=multi-user.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/local/bin/set-fanspeeds.sh
        ExecStart=/usr/bin/touch /etc/ignition-task-tracking/2-fanspeed-service
        [Install]
        WantedBy=multi-user.target
